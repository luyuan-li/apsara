{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Apsara",
  "version": "0.1.0",
  "identifier": "li.luyuan.apsara",
  "build": {
    "beforeDevCommand": "pnpm --filter @apsara/desktop dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm --filter @apsara/desktop build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Apsara",
        "width": 420,
        "height": 680,
        "transparent": false,
        "decorations": true,
        "alwaysOnTop": true,
        "resizable": true,
        "shadow": false,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "dmg",
    "icon": [
      "icons/icon.png"
    ]
  }
}
